{
  "datasets": [
    {
      "name": "f119c518",
      "displayName": "Location Data",
      "queryLines": [
        "select latitude,longitude,`GHG emissions mtons CO2e` as Emissions\r\n",
        "from `emissions-catalog`.default.emissions_data;"
      ]
    },
    {
      "name": "62b5ba80",
      "displayName": "Emissions per person",
      "queryLines": [
        "SELECT county_state_name,\r\n",
        "       population,\r\n",
        "       cast(\r\n",
        "         replace(`GHG emissions mtons CO2e`, ',', '')\r\n",
        "         AS DOUBLE\r\n",
        "       ) / nullif(\r\n",
        "         cast(\r\n",
        "           replace(population, ',', '')\r\n",
        "           AS DOUBLE\r\n",
        "         ), 0\r\n",
        "       ) AS pollution_emitted_per_person\r\n",
        "FROM emissions_data\r\n",
        "ORDER BY pollution_emitted_per_person desc\r\n",
        "\r\n"
      ],
      "catalog": "emissions-catalog",
      "schema": "default"
    },
    {
      "name": "3c2ace75",
      "displayName": "Total Emission per State",
      "queryLines": [
        "SELECT state_abbr,\r\n",
        "     sum(cast(\r\n",
        "         replace(`GHG emissions mtons CO2e`, ',', '')\r\n",
        "         AS DOUBLE\r\n",
        "       ) ) AS Total_Emissions\r\n",
        "FROM emissions_data\r\n",
        "GROUP BY state_abbr\r\n",
        "ORDER BY Total_Emissions DESC\r\n",
        "LIMIT 10\r\n",
        "\r\n"
      ],
      "catalog": "emissions-catalog",
      "schema": "default"
    },
    {
      "name": "a2b7888c",
      "displayName": "Polluted County",
      "queryLines": [
        "SELECT county_state_name,\r\n",
        "       population,\r\n",
        "       cast(\r\n",
        "         replace(`GHG emissions mtons CO2e`, ',', '')\r\n",
        "         AS DOUBLE ) AS Total_Emissions\r\n",
        "    \r\n",
        "FROM emissions_data\r\n",
        "ORDER BY Total_Emissions desc\r\n",
        "LIMIT 10\r\n"
      ],
      "catalog": "emissions-catalog",
      "schema": "default"
    }
  ],
